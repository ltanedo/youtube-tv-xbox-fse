{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "YouTubeTV",
  "version": "1.0.2",
  "identifier": "com.haroon01.youtubetvclient",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "https://youtube.com/tv"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "tauri",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
